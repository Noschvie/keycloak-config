# keycloak-config -- runtime environment
#
# Copy to ./environment (Git-ignored), fill in, then:
#   chmod 600 environment
#   set -a; . ./environment; set +a
#
# This file is read by the shell. Keep it to simple values (no spaces,
# quotes, $, !, backslashes). Put passwords and secrets into separate
# files and reference them with the *_FILE variables below -- secret
# files are read verbatim, so ANY character (incl. umlauts) is allowed.
#
# Secret files (Git-ignored directory secrets/):
#   mkdir -p secrets && chmod 700 secrets
#   printf '%s' 'the-secret' > secrets/admin-password   # or use an editor
#   chmod 600 secrets/*
#
# If both NAME and NAME_FILE are set, NAME_FILE wins.

# --- Target Keycloak ---------------------------------------------------
# Name of the Keycloak container; kcadm.sh runs inside it via docker exec.
#   keycloak       = instance with realm tasmofleet (PostgreSQL)
#   dev-keycloak-1 = development / test instance (H2)
KC_CONTAINER=dev-keycloak-1

# Admin API endpoint as seen from inside the container
KC_SERVER_URL=http://localhost:8080

# Account used by the scripts to authenticate
KC_ADMIN_REALM=master
KC_ADMIN_USER=admin
# Password file (recommended). Leave both empty to be prompted.
KC_ADMIN_PASSWORD_FILE=secrets/admin-password
# KC_ADMIN_PASSWORD=

# --- TasmoFleet client --------------------------------------------------
# Base URL of TasmoFleet, lower case, no trailing slash
TASMOFLEET_BASE_URL=https://tasmofleet.example.org

# Confidential client secret -- must match the secret configured in
# TasmoFleet.
TASMOFLEET_CLIENT_SECRET_FILE=secrets/tasmofleet-client-secret
# TASMOFLEET_CLIENT_SECRET=

# --- Users ---------------------------------------------------------------
# Initial password for NEW users (temporary credential, must be changed
# at first login). No default: required whenever a user is created,
# not needed for runs that only update existing users.
# Enable when adding users (the file must exist once this is set):
# KC_USER_INITIAL_PASSWORD_FILE=secrets/user-initial-password
# KC_USER_INITIAL_PASSWORD=
