{
  "clientId": "tasmofleet",
  "name": "Tasmota Fleet",
  "protocol": "openid-connect",
  "enabled": true,

  "publicClient": false,
  "clientAuthenticatorType": "client-secret",

  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "fullScopeAllowed": false,
  "frontchannelLogout": true,

  "rootUrl": "${TASMOFLEET_BASE_URL}",
  "adminUrl": "${TASMOFLEET_BASE_URL}",
  "baseUrl": "${TASMOFLEET_BASE_URL}",
  "redirectUris": ["${TASMOFLEET_BASE_URL}/oidc/callback"],
  "webOrigins": ["${TASMOFLEET_BASE_URL}"],

  "attributes": {
    "post.logout.redirect.uris": "${TASMOFLEET_BASE_URL}/*",
    "login_theme": "tasmofleet",
    "logoUri": "https://raw.githubusercontent.com/hellwand/tasmofleet/main/assets/branding/icon-512.png"
  },

  "protocolMappers": [
    {
      "name": "tasmofleet-groups",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-group-membership-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "groups",
        "full.path": "false",
        "multivalued": "true",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true",
        "introspection.token.claim": "true",
        "lightweight.claim": "false"
      }
    }
  ]
}
