{
  "client": {
    "clientId": "keycloak-config",
    "name": "keycloak-config automation",
    "description": "Service account used by the keycloak-config scripts",
    "protocol": "openid-connect",
    "enabled": true,
    "publicClient": false,
    "clientAuthenticatorType": "client-secret",
    "serviceAccountsEnabled": true,
    "standardFlowEnabled": false,
    "implicitFlowEnabled": false,
    "directAccessGrantsEnabled": false
  },
  "defaultClientScopes": ["kc-admin-api"],
  "realmRoles": ["create-realm"],
  "realmManagementRoles": [
    "view-realm",
    "manage-realm",
    "query-clients",
    "view-clients",
    "manage-clients",
    "query-users",
    "view-users",
    "manage-users",
    "query-groups"
  ]
}
